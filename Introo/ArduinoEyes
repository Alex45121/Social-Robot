// ---------------- EMOTION COLORS ----------------
int getEmotionHue(Emotion e) {
  switch (e) {
    case NEUTRAL:     return 110; // calm blue
    case QUESTIONING: return 45;  // yellow
    case COMFORT:     return 95;  // soft green
    case HAPPY:       return 35;  // warm orange/yellow
    case SAD:         return 160; // deeper blue
    case FROWN:       return 15;   // red
    case BREATHE:     return 145; // soft cyan-blue
  }

  return 170;
}

// ---------------- BREATHING ANIMATION ----------------
int getBreathingBrightness() {
  // 8-second breathing cycle: 4 sec inhale, 4 sec exhale
  unsigned long cycle = millis() % 8000;
  float phase = cycle / 8000.0;

  // Smooth wave from dim to bright to dim
  float wave = (sin(phase * TWO_PI - HALF_PI) + 1.0) / 2.0;

  // Brightness range
  return 2 + wave * 16;
}

// ---------------- BLINK TRIGGER ----------------
void trigger_blink() {
  do_blink = true;
  blink_step = 0;
  blink_timer = millis();
}

// ---------------- MAIN EYE LOGIC ----------------
void run_eyes() {
  pixels.clear();

  // No blinking during breathing mode
  if (emotion != BREATHE &&
      !do_blink &&
      millis() - last_blink_trigger > blink_interval) {

    trigger_blink();
    last_blink_trigger = millis();
    blink_interval = random(3500, 7000);
  }

  int hue = getEmotionHue(emotion);

  // Breathing brightness animation
  if (emotion == BREATHE && !do_blink) {
    LED_BRIGHTNESS = getBreathingBrightness();
  } else {
    LED_BRIGHTNESS = 8;
  }

  // ---- BLINK OVERRIDE ----
  if (do_blink) {
    unsigned long elapsed = millis() - blink_timer;

    if (elapsed < 100) {
      display_eyes(blink1, hue);
    } else if (elapsed < 220) {
      display_eyes(blink2, hue);
    } else if (elapsed < 340) {
      display_eyes(blink1, hue);
    } else {
      do_blink = false;
    }

    pixels.show();
    return;
  }

  // ---- EMOTION DISPLAY ----
  switch (emotion) {
    case NEUTRAL:     display_eyes(neutral, hue);     break;
    case QUESTIONING: display_eyes(questioning, hue); break;
    case COMFORT:     display_eyes(comfort, hue);     break;
    case HAPPY:       display_eyes(happy, hue);       break;
    case SAD:         display_eyes(sad, hue);         break;
    case FROWN:       display_eyes(frown, hue);       break;
    case BREATHE:     display_eyes(breathe, hue);     break;
  }

  pixels.show();
}

// ---------------- DRAW EYES ----------------
void display_eyes(byte arr[], int hue) {
  display_eye(arr, hue, true);
  display_eye(arr, hue, false);
}

void display_eye(byte arr[], int hue, bool left) {
  int rows[] = { 4, 5, 6, 7, 6, 5, 4 };
  int index = (left) ? 0 : 37;

  for (int i = 0; i < 7; i++) {
    for (int j = 0; j < rows[i]; j++) {

      int brightness = LED_BRIGHTNESS * bitRead(arr[i], (left) ? rows[i] - 1 - j : j);

      pixels.setPixelColor(
        index,
        pixels.ColorHSV(hue * 256, 255, brightness)
      );

      index++;
    }
  }
}