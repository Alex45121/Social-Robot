// Created with the help of AI
#include <Adafruit_NeoPixel.h>
#include <SoftwareSerial.h>
#include "KT403A_Player.h"

// ---------------- PIN SETUP ----------------
#define LEFT_LED_PIN 4
#define RIGHT_LED_PIN 8
#define PIXELS_PER_EYE 37

// 0 = no rotation, 1 = 1/3 turn, 2 = 2/3 turn
#define LEFT_ROTATION_STEPS -2
#define RIGHT_ROTATION_STEPS 0

// Try true/false if the right eye is wired backwards
#define RIGHT_REVERSED true

SoftwareSerial mp3(2, 3);
KT403A<SoftwareSerial> Mp3Player;

Adafruit_NeoPixel leftEye(PIXELS_PER_EYE, LEFT_LED_PIN);
Adafruit_NeoPixel rightEye(PIXELS_PER_EYE, RIGHT_LED_PIN);

int LED_BRIGHTNESS = 8;
unsigned long last_blink_trigger = 0;
int blink_interval = 4500;

// ---------------- EMOTIONS ----------------
enum Emotion {
  NEUTRAL,
  QUESTIONING,
  COMFORT,
  HAPPY,
  SAD,
  FROWN,
  BREATHE
};

Emotion emotion = NEUTRAL;

// ---------------- BLINK ----------------
bool do_blink = false;
unsigned long blink_timer = 0;

// ---------------- EYE PATTERNS ----------------
byte neutral[]     = { B0000, B01110, B011110, B0111110, B011110, B01110, B0000 };
byte blink1[]      = { B0000, B00000, B011110, B0111110, B011110, B00000, B0000 };
byte blink2[]      = { B0000, B00000, B000000, B1111111, B000000, B00000, B0000 };

byte questioning[] = { B1111, B11111, B111111, B1111111, B111111, B11111, B1111 };
byte comfort[]     = { B0000, B00000, B100001, B1100011, B111111, B11111, B1111 };
byte happy[]       = { B1111, B11111, B111111, B1100011, B000000, B00000, B0000 };
byte sad[]         = { B0000, B00001, B000011, B0001111, B011111, B11111, B1111 };
byte frown[]       = { B0000, B00000, B100000, B1110000, B111000, B11111, B1111 };
byte breathe[]     = { B0000, B00100, B011110, B0111110, B011110, B00100, B0000 };

// ---------------- HEX GRID ----------------
struct HexCoord {
  int q;
  int r;
};

int rows[] = { 4, 5, 6, 7, 6, 5, 4 };

HexCoord indexToCoord(int index) {
  int counter = 0;

  for (int row = 0; row < 7; row++) {
    int r = row - 3;
    int qStart = max(-3, -r - 3);

    for (int col = 0; col < rows[row]; col++) {
      if (counter == index) {
        HexCoord c = { qStart + col, r };
        return c;
      }
      counter++;
    }
  }

  HexCoord fallback = { 0, 0 };
  return fallback;
}

int coordToIndex(HexCoord c) {
  int counter = 0;

  for (int row = 0; row < 7; row++) {
    int r = row - 3;
    int qStart = max(-3, -r - 3);

    for (int col = 0; col < rows[row]; col++) {
      int q = qStart + col;

      if (q == c.q && r == c.r) {
        return counter;
      }

      counter++;
    }
  }

  return 0;
}

HexCoord rotateHex120(HexCoord c) {
  HexCoord rotated = { -c.q - c.r, c.q };
  return rotated;
}

HexCoord rotateHex240(HexCoord c) {
  HexCoord rotated = { c.r, -c.q - c.r };
  return rotated;
}

HexCoord applyHexRotation(HexCoord c, int steps) {
  if (steps == 1) {
    return rotateHex120(c);
  } else if (steps == 2) {
    return rotateHex240(c);
  }

  return c;
}

// ---------------- SETUP ----------------
void setup() {
  leftEye.begin();
  rightEye.begin();

  leftEye.clear();
  rightEye.clear();

  leftEye.show();
  rightEye.show();

  Serial.begin(115200);

  mp3.begin(9600);
  delay(1000);
  Mp3Player.init(mp3);
  Mp3Player.volume(30);

  randomSeed(analogRead(A0));

  Serial.println("Robot Ready");
}

// ---------------- LOOP ----------------
void loop() {
  communication();
  run_eyes();
}

// ---------------- SERIAL COMMUNICATION ----------------
void communication() {
  if (Serial.available()) {
    String data = Serial.readStringUntil('\n');
    data.trim();

    if (data.length() == 0) return;

    Serial.print("Received: ");
    Serial.println(data);

    if (data == "N") emotion = NEUTRAL;
    else if (data == "Q") emotion = QUESTIONING;
    else if (data == "C") emotion = COMFORT;
    else if (data == "H") emotion = HAPPY;
    else if (data == "S") emotion = SAD;
    else if (data == "F") emotion = FROWN;
    else if (data == "B") emotion = BREATHE;
  }
}

// ---------------- EMOTION COLORS ----------------
int getEmotionHue(Emotion e) {
  switch (e) {
    case NEUTRAL:     return 110;
    case QUESTIONING: return 45;
    case COMFORT:     return 95;
    case HAPPY:       return 35;
    case SAD:         return 160;
    case FROWN:       return 15;
    case BREATHE:     return 145;
  }

  return 110;
}

// ---------------- BREATHING ANIMATION ----------------
int getBreathingBrightness() {
  unsigned long cycle = millis() % 8000;
  float phase = cycle / 8000.0;

  float wave = (sin(phase * TWO_PI - HALF_PI) + 1.0) / 2.0;

  return 2 + wave * 16;
}

// ---------------- BLINK TRIGGER ----------------
void trigger_blink() {
  do_blink = true;
  blink_timer = millis();
}

// ---------------- MAIN EYE LOGIC ----------------
void run_eyes() {
  leftEye.clear();
  rightEye.clear();

  if (emotion != BREATHE &&
      !do_blink &&
      millis() - last_blink_trigger > blink_interval) {

    trigger_blink();
    last_blink_trigger = millis();
    blink_interval = random(3500, 7000);
  }

  int hue = getEmotionHue(emotion);

  if (emotion == BREATHE && !do_blink) {
    LED_BRIGHTNESS = getBreathingBrightness();
  } else {
    LED_BRIGHTNESS = 8;
  }

  if (do_blink) {
    unsigned long elapsed = millis() - blink_timer;

    if (elapsed < 100) {
      display_eyes(blink1, hue);
    } else if (elapsed < 220) {
      display_eyes(blink2, hue);
    } else if (elapsed < 340) {
      display_eyes(blink1, hue);
    } else {
      do_blink = false;
    }

    leftEye.show();
    rightEye.show();
    return;
  }

  switch (emotion) {
    case NEUTRAL:     display_eyes(neutral, hue);     break;
    case QUESTIONING: display_eyes(questioning, hue); break;
    case COMFORT:     display_eyes(comfort, hue);     break;
    case HAPPY:       display_eyes(happy, hue);       break;
    case SAD:         display_eyes(sad, hue);         break;
    case FROWN:       display_eyes(frown, hue);       break;
    case BREATHE:     display_eyes(breathe, hue);     break;
  }

  leftEye.show();
  rightEye.show();
}

// ---------------- DRAW BOTH EYES ----------------
void display_eyes(byte arr[], int hue) {
  display_eye(leftEye, arr, hue, true);
  display_eye(rightEye, arr, hue, false);
}

// ---------------- DRAW ONE EYE ----------------
void display_eye(Adafruit_NeoPixel &eye, byte arr[], int hue, bool isLeftEye) {
  int index = 0;

  for (int row = 0; row < 7; row++) {
    for (int col = 0; col < rows[row]; col++) {

      int bitValue = bitRead(arr[row], isLeftEye ? rows[row] - 1 - col : col);
      int brightness = LED_BRIGHTNESS * bitValue;

      HexCoord coord = indexToCoord(index);

      if (isLeftEye) {
        coord = applyHexRotation(coord, LEFT_ROTATION_STEPS);
      } else {
        coord = applyHexRotation(coord, RIGHT_ROTATION_STEPS);
      }

      int ledIndex = coordToIndex(coord);

      if (!isLeftEye && RIGHT_REVERSED) {
        ledIndex = PIXELS_PER_EYE - 1 - ledIndex;
      }

      eye.setPixelColor(
        ledIndex,
        eye.ColorHSV(hue * 256, 255, brightness)
      );

      index++;
    }
  }
}