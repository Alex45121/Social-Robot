#include <Adafruit_NeoPixel.h>
#include <SoftwareSerial.h>
#include "KT403A_Player.h"

// ---------------- PIN SETUP ----------------
#define LED_PIN 4
#define NUMPIXELS 74

SoftwareSerial mp3(2, 3);  // RX, TX
KT403A<SoftwareSerial> Mp3Player;

Adafruit_NeoPixel pixels(NUMPIXELS, LED_PIN);

int LED_BRIGHTNESS = 8;
unsigned long last_blink_trigger = 0;
int blink_interval = 4500;

// ---------------- EMOTIONS ----------------
enum Emotion { NEUTRAL,
               QUESTIONING,
               COMFORT,
               HAPPY,
               SAD,
               FROWN,
               BREATHE };

Emotion emotion = NEUTRAL;

// ---------------- BLINK ----------------
bool do_blink = false;
int blink_step = 0;
unsigned long blink_timer = 0;

// ---------------- EYE PATTERNS ----------------
byte neutral[]     = { B0000, B01110, B011110, B0111110, B011110, B01110, B0000 };
byte blink1[]      = { B0000, B00000, B011110, B0111110, B011110, B00000, B0000 };
byte blink2[]      = { B0000, B00000, B000000, B1111111, B000000, B00000, B0000 };

byte questioning[] = { B1111, B11111, B111111, B1111111, B111111, B11111, B1111 };
byte comfort[]     = { B0000, B00000, B100001, B1100011, B111111, B11111, B1111 };
byte happy[]       = { B1111, B11111, B111111, B1100011, B000000, B00000, B0000 };
byte sad[]         = { B0000, B00001, B000011, B0001111, B011111, B11111, B1111 };
byte frown[]       = { B0000, B00000, B100000, B1110000, B111000, B11111, B1111 };

// Larger, softer breathing eye shape
byte breathe[]     = { B0000, B00100, B011110, B0111110, B011110, B00100, B0000 };

// ---------------- SETUP ----------------
void setup() {
  pixels.begin();
  pixels.clear();
  pixels.show();

  Serial.begin(115200);

  // MP3 INIT
  mp3.begin(9600);
  delay(1000);
  Mp3Player.init(mp3);
  Mp3Player.volume(30);

  randomSeed(analogRead(A0));

  Serial.println("Robot Ready");
}

// ---------------- LOOP ----------------
void loop() {
  communication();
  run_eyes();
}

// ---------------- SERIAL COMMUNICATION ----------------
void communication() {
  if (Serial.available()) {

    String data = Serial.readStringUntil('\n');
    data.trim();

    if (data.length() == 0) return;

    Serial.print("Received: ");
    Serial.println(data);

    Emotion previous = emotion;

    if (data == "N") emotion = NEUTRAL;
    else if (data == "Q") emotion = QUESTIONING;
    else if (data == "C") emotion = COMFORT;
    else if (data == "H") emotion = HAPPY;
    else if (data == "S") emotion = SAD;
    else if (data == "F") emotion = FROWN;
    else if (data == "B") emotion = BREATHE;

    // Optional sound trigger
    // if (emotion != previous) {
    //   playEmotionSound(emotion);
    // }
  }
}

